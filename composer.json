{
    "name": "lenincrdva/xades-bes-signer",
    "description": "PHP library to sign and verify XML documents under the XAdES-BES standard, compliant with the SRI (Ecuador) electronic invoicing requirements.",
    "type": "library",
    "license": "MIT",
    "keywords": ["xades", "xades-bes", "xml", "signature", "digital-signature", "sri", "ecuador", "factura-electronica", "xmlsec", "p12"],
    "authors": [
        {
            "name": "lenincrdva",
            "email": "cordovalenin.44@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-openssl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "XadesBesSigner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XadesBesSigner\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "fixtures:generate": "php tests/fixtures/generate-test-cert.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
